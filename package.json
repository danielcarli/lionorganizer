{
  "name": "lionorganizer",
  "version": "1.1.6",
  "description": "LionOrganizer — disk space analysis & cleanup. See what takes up space in your folders, find true duplicates by content and safely free up what you no longer need.",
  "main": "src/code/electron-main/main.js",
  "desktopName": "lionorganizer.desktop",
  "scripts": {
    "start": "electron .",
    "dist": "npx --yes electron-builder@26.18.0 --publish never",
    "dist:win": "npx --yes electron-builder@26.18.0 --win --publish never",
    "dist:mac": "npx --yes electron-builder@26.18.0 --mac --publish never",
    "dist:linux": "npx --yes electron-builder@26.18.0 --linux --publish never",
    "test:e2e": "electron tools/e2e.js",
    "test:i18n": "node tools/check-i18n.js",
    "shots": "electron tools/screenshot.js",
    "docs:screenshots": "electron tools/docs-screenshots.js",
    "release:assets": "node tools/make-release.js"
  },
  "author": "LionOrganizer Team",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "electron": "^45.2.3"
  },
  "productName": "LionOrganizer",
  "build": {
    "appId": "br.dmdc.lionorganizer",
    "productName": "LionOrganizer",
    "copyright": "Copyright © 2026 LionOrganizer Team",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "LionOrganizer",
      "artifactName": "LionOrganizer-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "LionOrganizer",
      "include": "build/installer.nsh",
      "uninstallDisplayName": "LionOrganizer — disk space analysis & cleanup",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "pt_BR",
        "pt_PT",
        "es_ES",
        "fr_FR",
        "de_DE",
        "it_IT",
        "zh_CN",
        "ja_JP",
        "ko_KR"
      ],
      "license": "LICENSE",
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "LionOrganizer-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "LionOrganizer-mac-${arch}.${ext}",
      "identity": "-"
    },
    "dmg": {
      "title": "LionOrganizer ${version}"
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icons",
      "executableName": "lionorganizer",
      "synopsis": "Disk space analysis & cleanup",
      "description": "See what takes up space in your folders, find true duplicates by content (SHA-256) and safely free up what you no longer need. Every file change requires a typed confirmation code.",
      "vendor": "LionOrganizer Team",
      "maintainer": "LionOrganizer Team <danielcarli@users.noreply.github.com>",
      "desktop": {
        "entry": {
          "Name": "LionOrganizer",
          "GenericName": "Disk Space Analyzer",
          "Comment": "Disk space analysis & cleanup",
          "Keywords": "disk;space;usage;duplicates;cleanup;organize;",
          "StartupWMClass": "LionOrganizer"
        }
      },
      "artifactName": "LionOrganizer-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "lionorganizer_${arch}.${ext}"
    },
    "rpm": {
      "artifactName": "lionorganizer.${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "LionOrganizer-${arch}.${ext}"
    }
  },
  "keywords": [
    "disk-space",
    "disk-usage",
    "duplicate-finder",
    "file-organizer",
    "cleanup",
    "electron",
    "windows"
  ],
  "contributors": [
    "Daniel Michelon De Carli (creator)"
  ],
  "homepage": "https://github.com/danielcarli/lionorganizer",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielcarli/lionorganizer.git"
  },
  "bugs": {
    "url": "https://github.com/danielcarli/lionorganizer/issues"
  }
}
